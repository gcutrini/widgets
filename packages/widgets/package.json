    "./core/host-auth": "./src/core/host-auth.ts",
    "./core/host-config": "./src/core/host-config.ts",
    "./core/widget-auth-error": "./src/core/widget-auth-error.ts",
    "./core/widget-notify": "./src/core/widget-notify.ts",
    "./registration/manifest": "./src/registration/manifest.tsx",
    "./schedule-full/manifest": "./src/schedule-full/manifest.tsx",
