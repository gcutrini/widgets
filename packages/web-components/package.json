{
  "name": "@openeventkit/web-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Legacy widgets as self-contained React-17 web components, built via esbuild into static assets: ES-module bundles whose shared framework/uicore/MUI imports resolve through an import map the host inlines.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:standalone": "node scripts/build.mjs --standalone",
    "analyze": "node scripts/analyze-widgets.mjs",
    "analyze:check": "node scripts/analyze-widgets.mjs --check",
    "analyze:baseline": "node scripts/analyze-widgets.mjs --update-baseline",
    "test": "node --test \"scripts/__tests__/*.test.mjs\""
  },
  "dependencies": {
    "@emotion/cache": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/base": "5.0.0-alpha.127",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@mui/styled-engine": "5.18.0",
    "@mui/system": "5.18.0",
    "@openeventkit/widget-core": "workspace:*",
    "@openeventkit/widgets": "workspace:*",
    "@react-pdf/renderer": "^3.1.11",
    "awesome-bootstrap-checkbox": "catalog:",
    "browser-tabs-lock": "^1.2.15",
    "chain-function": "catalog:",
    "crypto-js": "catalog:",
    "dropzone": "^5.7.2",
    "extend": "^3.0.1",
    "final-form": "catalog:",
    "font-awesome": "catalog:",
    "history": "^4.7.2",
    "i18n-react": "catalog:",
    "idtoken-verifier": "catalog:",
    "immutability-helper": "^2.7.1",
    "jodit-react": "^5.0.10",
    "js-cookie": "^3.0.5",
    "lodash": "catalog:",
    "moment": "catalog:",
    "moment-timezone": "catalog:",
    "openstack-uicore-foundation": "catalog:",
    "prop-types": "^15.8.1",
    "react": "17.0.2",
    "react-bootstrap": "catalog:",
    "react-datetime": "^2.16.2",
    "react-dnd": "^16.0.0",
    "react-dnd-html5-backend": "^16.0.0",
    "react-dom": "17.0.2",
    "react-dropzone": "^4.2.9",
    "react-final-form": "catalog:",
    "react-google-maps": "^9.4.5",
    "react-redux": "catalog:",
    "react-rte": "^0.16.3",
    "react-select": "^2.4.3",
    "react-slick": "^0.27.0",
    "react-star-ratings": "^2.3.0",
    "react-tooltip": "^3.11.1",
    "redux": "catalog:",
    "redux-persist": "catalog:",
    "redux-thunk": "catalog:",
    "slick-carousel": "^1.8.1",
    "spark-md5": "catalog:",
    "superagent": "catalog:",
    "sweetalert2": "catalog:",
    "urijs": "^1.19.1",
    "use-sync-external-store": "^1.4.0",
    "validator": "^9.4.1",
    "video.js": "^7.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "esbuild-plugin-polyfill-node": "^0.3.0"
  },
  "bin": {
    "widgets-build": "./scripts/build.mjs",
    "widgets-analyze": "./scripts/analyze-widgets.mjs"
  }
}
